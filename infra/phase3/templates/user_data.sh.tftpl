#!/bin/bash
# First-boot bootstrap for the wedding-site EC2 instance.
#
# Runs once as root via cloud-init on instance launch. Idempotent-friendly
# but assumes a fresh AL2023 image. Any failure (set -e) aborts and leaves
# the machine reachable via SSM Session Manager for diagnosis. Full log at
# /var/log/user-data.log.
#
# Rendered by Terraform templatefile() with:
#   app_dir          — where the repo is cloned
#   repo_url         — public GitHub URL, no creds needed
#   ssm_prefix       — /wedding-site/prod
#   aws_region       — us-east-1
#   gunicorn_service — the full systemd unit contents
#   nginx_conf       — the full nginx server block
#
# Design: system-level bits (dnf install, systemd) run as root here.
# App-tier bits (git clone, pip, pnpm, migrate, collectstatic) run via
# runuser -u ec2-user against helper scripts staged to /tmp. That avoids
# nested-heredoc quoting hazards and keeps file ownership sane.

set -euxo pipefail
exec > >(tee -a /var/log/user-data.log) 2>&1

APP_DIR="${app_dir}"
REPO_URL="${repo_url}"
SSM_PREFIX="${ssm_prefix}"
AWS_REGION="${aws_region}"

echo "=== user_data begin ($(date -Is)) ==="

# --------------------------------------------------------------------------
# System packages
# --------------------------------------------------------------------------
dnf -y update
dnf -y install \
    python3.12 \
    python3.12-devel \
    python3.12-pip \
    nginx \
    git \
    nodejs20 \
    npm \
    postgresql17 \
    tar \
    gzip

corepack enable
corepack prepare pnpm@11.17.0 --activate

# --------------------------------------------------------------------------
# App bootstrap (as ec2-user via a staged helper script)
# --------------------------------------------------------------------------
cat > /tmp/bootstrap-app.sh <<'BOOTSTRAP'
#!/bin/bash
set -euxo pipefail

APP_DIR="$1"
REPO_URL="$2"
SSM_PREFIX="$3"
AWS_REGION="$4"

# Clone repo (skip if directory already exists).
if [ ! -d "$APP_DIR" ]; then
    git clone "$REPO_URL" "$APP_DIR"
fi

# Python venv + backend deps.
cd "$APP_DIR"
python3.12 -m venv .venv
.venv/bin/pip install --upgrade pip
.venv/bin/pip install -r backend/requirements/production.txt

# Frontend build (writes to backend/static/frontend/).
cd "$APP_DIR/frontend"
pnpm install --frozen-lockfile
pnpm build

# Fetch every /wedding-site/prod/* SSM param into backend/.env.
# One aws call, output as JSON, parsed by python for correct escaping.
ENV_FILE="$APP_DIR/backend/.env"
umask 0077
aws ssm get-parameters-by-path \
    --path "$SSM_PREFIX/" \
    --with-decryption \
    --region "$AWS_REGION" \
    --recursive \
    --output json \
  | python3.12 -c '
import json, os, sys, shlex
data = json.load(sys.stdin)
prefix = os.environ["SSM_PREFIX"] + "/"
with open(os.environ["ENV_FILE"], "w") as f:
    for p in sorted(data["Parameters"], key=lambda x: x["Name"]):
        key = p["Name"].removeprefix(prefix)
        # shlex.quote wraps in single-quotes and escapes embedded quotes.
        f.write(f"{key}={shlex.quote(p[\"Value\"])}\n")
'
chmod 0600 "$ENV_FILE"
export SSM_PREFIX ENV_FILE  # Ensure the python subshell sees them.

# migrate + collectstatic using the venv + .env.
cd "$APP_DIR/backend"
set -a
. "$ENV_FILE"
set +a
"$APP_DIR/.venv/bin/python" manage.py migrate --settings=config.settings.production --noinput
"$APP_DIR/.venv/bin/python" manage.py collectstatic --settings=config.settings.production --noinput
BOOTSTRAP
chmod +x /tmp/bootstrap-app.sh

# Pass SSM_PREFIX + ENV_FILE via env so the inline python one-liner picks
# them up. Also export AWS_REGION for the aws cli calls.
SSM_PREFIX="$SSM_PREFIX" \
ENV_FILE="$APP_DIR/backend/.env" \
    runuser -u ec2-user -- /tmp/bootstrap-app.sh \
        "$APP_DIR" "$REPO_URL" "$SSM_PREFIX" "$AWS_REGION"

rm -f /tmp/bootstrap-app.sh

# --------------------------------------------------------------------------
# systemd unit for gunicorn
# --------------------------------------------------------------------------
cat > /etc/systemd/system/gunicorn.service <<'GUNICORNEOF'
${gunicorn_service}
GUNICORNEOF

# --------------------------------------------------------------------------
# nginx server block
# --------------------------------------------------------------------------
cat > /etc/nginx/conf.d/wedding-site.conf <<'NGINXEOF'
${nginx_conf}
NGINXEOF

# AL2023's stock /etc/nginx/nginx.conf includes a default `server { listen 80
# default_server; ... }` block that conflicts with ours (both default_server
# on port 80). Neutralize by commenting the block out — ours takes over.
sed -i.bak '/^\s*server\s*{/,/^\s*}/ s/^/# /' /etc/nginx/nginx.conf

# --------------------------------------------------------------------------
# Start services. systemd creates /run/gunicorn via RuntimeDirectory.
# --------------------------------------------------------------------------
systemctl daemon-reload
systemctl enable --now gunicorn
systemctl enable --now nginx

# --------------------------------------------------------------------------
# Post-flight sanity
# --------------------------------------------------------------------------
systemctl is-active gunicorn
systemctl is-active nginx
sleep 2
curl -sI -o /dev/null -w "localhost: %{http_code}\n" http://localhost/ || true

echo "=== user_data done ($(date -Is)) ==="
