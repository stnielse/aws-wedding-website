#!/bin/bash
# First-boot bootstrap for the wedding-site EC2 instance.
#
# Runs once as root via cloud-init on instance launch. Any failure (set -e)
# aborts and leaves the machine reachable via SSM Session Manager for
# diagnosis. Full log at /var/log/user-data.log.
#
# Rendered by Terraform templatefile() with:
#   app_dir          — where the repo is cloned (/home/ec2-user/aws-wedding-website)
#   repo_url         — public GitHub URL, no creds needed
#   ssm_prefix       — /wedding-site/prod
#   aws_region       — us-east-1
#   gunicorn_service — the full systemd unit contents
#   nginx_conf       — the full nginx server block
#
# Design: system-level bits (dnf, systemd, nginx config) run as root here.
# App-tier bits (git clone, pip, pnpm, migrate, collectstatic) run via
# runuser against a helper script staged to /tmp — that avoids nested-
# heredoc quoting hazards and keeps file ownership sane.

set -euxo pipefail
exec > >(tee -a /var/log/user-data.log) 2>&1

APP_DIR="${app_dir}"
REPO_URL="${repo_url}"
SSM_PREFIX="${ssm_prefix}"
AWS_REGION="${aws_region}"

echo "=== user_data begin ($(date -Is)) ==="

# --------------------------------------------------------------------------
# System packages
# --------------------------------------------------------------------------
dnf -y update
# NOTE: do NOT list the bare `npm` package here -- on AL2023 that resolves
# to `nodejs-npm` (npm for node 18) which drags node 18 in as a dep and
# leaves `alternatives --display node` ambiguous. `nodejs22` alone pulls
# `nodejs22-npm` as a weak dep, giving us node 22 + its matching npm.
#
# Node 22 (not 20) because frontend/package.json pins pnpm@11.17.0, and
# pnpm 11 requires Node >= 22.13.
dnf -y install \
    python3.12 \
    python3.12-devel \
    python3.12-pip \
    nginx \
    git \
    nodejs22 \
    postgresql17 \
    jq \
    tar \
    gzip

# Pin node 22 in alternatives in case dnf ordering ever changes.
alternatives --set node /usr/bin/node-22 || true

# pnpm via a direct global npm install -- AL2023's nodejs22 package does not
# ship a /usr/bin/corepack shim, so `corepack enable` fails ("command not
# found"). npm-installed pnpm lands at /usr/bin/pnpm and works the same.
npm install -g pnpm@11.17.0

# --------------------------------------------------------------------------
# App bootstrap (as ec2-user via a staged helper script — env comes through
# via the args passed on the command line, no env-var inheritance games).
# --------------------------------------------------------------------------
cat > /tmp/bootstrap-app.sh <<'BOOTSTRAP'
#!/bin/bash
set -euxo pipefail

APP_DIR="$1"
REPO_URL="$2"
SSM_PREFIX="$3"
AWS_REGION="$4"

# Clone the public repo (skip if it already exists from a rerun).
if [ ! -d "$APP_DIR" ]; then
    git clone "$REPO_URL" "$APP_DIR"
fi

# Python venv + backend deps.
cd "$APP_DIR"
python3.12 -m venv .venv
.venv/bin/pip install --upgrade pip
.venv/bin/pip install -r backend/requirements/production.txt

# Frontend build (writes into backend/static/frontend/).
cd "$APP_DIR/frontend"
pnpm install --frozen-lockfile
pnpm build

# Fetch every /wedding-site/prod/* SSM param into backend/.env.
# jq's @sh filter emits single-quote-wrapped values with embedded quotes
# properly escaped, which is exactly the shape `set -a; . .env` expects.
ENV_FILE="$APP_DIR/backend/.env"
umask 0077
aws ssm get-parameters-by-path \
    --path "$SSM_PREFIX/" \
    --with-decryption \
    --region "$AWS_REGION" \
    --recursive \
    --output json \
  | jq -r --arg prefix "$SSM_PREFIX/" '
        .Parameters | sort_by(.Name)[] |
        "\(.Name | ltrimstr($prefix))=\(.Value | @sh)"
    ' > "$ENV_FILE"
chmod 0600 "$ENV_FILE"

# migrate + collectstatic using the venv + the freshly-written .env.
cd "$APP_DIR/backend"
set -a
. "$ENV_FILE"
set +a
"$APP_DIR/.venv/bin/python" manage.py migrate --settings=config.settings.production --noinput
"$APP_DIR/.venv/bin/python" manage.py collectstatic --settings=config.settings.production --noinput

# gunicorn wrapper. Bash-sources .env (which is @sh-formatted so bash
# parses quotes correctly) then execs gunicorn. Systemd's EnvironmentFile
# is not used because AL2023's systemd leaves single quotes literal in
# values, corrupting multi-value strings like ALLOWED_HOSTS.
mkdir -p "$APP_DIR/scripts"
cat > "$APP_DIR/scripts/run-gunicorn.sh" <<'RUNGUNICORNEOF'
#!/bin/bash
set -euo pipefail
APP_DIR="/home/ec2-user/aws-wedding-website"
set -a
. "$APP_DIR/backend/.env"
set +a
exec "$APP_DIR/.venv/bin/gunicorn" \
    --workers 3 \
    --bind unix:/run/gunicorn/gunicorn.sock \
    --umask 007 \
    --access-logfile - \
    --error-logfile - \
    config.wsgi:application
RUNGUNICORNEOF
chmod +x "$APP_DIR/scripts/run-gunicorn.sh"
BOOTSTRAP
chmod +x /tmp/bootstrap-app.sh

runuser -u ec2-user -- /tmp/bootstrap-app.sh \
    "$APP_DIR" "$REPO_URL" "$SSM_PREFIX" "$AWS_REGION"

rm -f /tmp/bootstrap-app.sh

# --------------------------------------------------------------------------
# systemd unit for gunicorn
# --------------------------------------------------------------------------
cat > /etc/systemd/system/gunicorn.service <<'GUNICORNEOF'
${gunicorn_service}
GUNICORNEOF

# --------------------------------------------------------------------------
# nginx: overwrite the stock main config (no default server block) and
# drop our server block into conf.d/. Sed'ing the stock file's inline
# server{} block is brittle because it nests location{} blocks -- range
# regexes stop at the first nested `}` and leave the file half-commented.
# Replacing the main config wholesale is simpler and drift-immune.
# --------------------------------------------------------------------------
cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.bak
cat > /etc/nginx/nginx.conf <<'NGINXMAINEOF'
${nginx_main}
NGINXMAINEOF

cat > /etc/nginx/conf.d/wedding-site.conf <<'NGINXEOF'
${nginx_conf}
NGINXEOF

nginx -t

# Add nginx to the ec2-user group so it can access the gunicorn socket
# (which lives in /run/gunicorn owned by ec2-user, and is created 660
# via gunicorn's --umask 007 in the systemd unit).
usermod -aG ec2-user nginx

# --------------------------------------------------------------------------
# Start services. systemd creates /run/gunicorn via RuntimeDirectory.
# gunicorn first so the socket exists before nginx tries to connect.
# --------------------------------------------------------------------------
systemctl daemon-reload
systemctl enable --now gunicorn
systemctl enable --now nginx

# --------------------------------------------------------------------------
# Post-flight sanity
# --------------------------------------------------------------------------
systemctl is-active gunicorn
systemctl is-active nginx
sleep 2
curl -sI -o /dev/null -w "localhost: %%{http_code}\n" http://localhost/ || true

echo "=== user_data done ($(date -Is)) ==="
