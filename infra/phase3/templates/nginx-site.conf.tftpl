upstream gunicorn {
    server unix:/run/gunicorn/gunicorn.sock;
}

# nginx picks the most-specific server_name first, so the three blocks
# below sort themselves: www -> apex 301, canonical -> gunicorn, and
# everything else (EIP hits, ec2-*.compute-1.amazonaws.com scans, bare
# `Host: _`) lands in the default_server 444 at the bottom. Session 20
# tightened this from a single default_server after a scanner spray on
# the EC2 hostname raised ~250 DisallowedHost ERRORs and paged the
# wedding-site-django-errors alarm; keeping wrong-Host traffic out of
# Django is the reason that alarm now stays quiet.

server {
    listen 80;
    listen [::]:80;
    server_name www.${domain_name};

    return 301 https://${domain_name}$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${domain_name};

    client_max_body_size 25M;

    # Scanner-probe short-circuits. None of these paths exist on this
    # site (no PHP, no WordPress, no dotfiles served), so we drop them
    # at nginx with 444 (close connection) + access_log off before they
    # wake gunicorn or land in the Django CloudWatch stream. Add a new
    # pattern as a one-liner when a fresh wave shows up in the log.
    location ~* /\.(?:env|git|aws|ssh|htaccess|htpasswd) {
        access_log off;
        return 444;
    }
    location ~* /(?:wp-(?:admin|login|content|includes|config|json)|xmlrpc\.php|phpmyadmin|phpMyAdmin|pma)(?:/|$) {
        access_log off;
        return 444;
    }

    location / {
        proxy_pass http://gunicorn;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_redirect                     off;
        proxy_read_timeout                 60s;
    }
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Wrong Host header -> silent close. CloudFront forwards the viewer
    # Host header verbatim, so all legitimate traffic hits the canonical
    # server block above. Requests reaching this block came in on the
    # EC2 public DNS name, the EIP, or with a bogus Host; none deserve
    # a response and none should reach Django.
    return 444;
}
