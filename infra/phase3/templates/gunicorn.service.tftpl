[Unit]
Description=gunicorn for wedding-site Django app
After=network-online.target
Wants=network-online.target

[Service]
# Type=simple (default): systemd treats the service as started as soon as
# ExecStart forks. Not Type=notify (that requires gunicorn[systemd], not
# in production.txt).
#
# NOTE: EnvironmentFile= is intentionally NOT used. AL2023's systemd
# leaves single quotes in EnvironmentFile values literal, which corrupts
# multi-value strings like ALLOWED_HOSTS. Instead ExecStart runs a small
# wrapper (scripts/run-gunicorn.sh) that bash-sources .env, then exec's
# gunicorn. Bash handles the @sh-formatted .env correctly.
#
# --umask 007 makes the unix socket rw-rw---- with group=ec2-user, so
# nginx (added to ec2-user in user_data) can connect. Without this,
# gunicorn inherits systemd's default umask and the socket is unreachable
# by the nginx user -> 502 Bad Gateway.
User=ec2-user
Group=ec2-user
WorkingDirectory=${app_dir}/backend
RuntimeDirectory=gunicorn
RuntimeDirectoryMode=0755
ExecStart=${app_dir}/scripts/run-gunicorn.sh
Restart=on-failure
RestartSec=5

# gunicorn stdout+stderr -> /var/log/gunicorn/gunicorn.log. The
# CloudWatch Agent (Session 15) tails this file into the
# /wedding-site/django log group. Not StandardOutput=journal because
# amazon-cloudwatch-agent 1.300 does not accept `journald` under
# logs.logs_collected -- only files, windows_events, and emf.
# LogsDirectory=gunicorn creates /var/log/gunicorn/ owned by ec2-user
# at service start, so append: can write the file without a chmod
# dance in user_data. Rotation is handled by logrotate config
# dropped in from user_data (see /etc/logrotate.d/gunicorn).
LogsDirectory=gunicorn
LogsDirectoryMode=0755
StandardOutput=append:/var/log/gunicorn/gunicorn.log
StandardError=append:/var/log/gunicorn/gunicorn.log

[Install]
WantedBy=multi-user.target
