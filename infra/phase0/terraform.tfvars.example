# Copy to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored via the repo-root .gitignore.

# Apex domain of the wedding site, no scheme, no trailing dot.
domain_name = "example.com"

# ACM certificate ARN in us-east-1 covering apex + www SANs. Look up in the
# ACM console (us-east-1) or `aws acm list-certificates --region us-east-1`.
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Hosted zone ID for the apex domain. Look up in the Route 53 console
# ("Hosted zones" → click the zone → Zone ID) or via
# `aws route53 list-hosted-zones-by-name --dns-name example.com`.
hosted_zone_id = "Z000000000000000000000"

# Optional. Applied as the Project tag on every resource. Defaults to
# "wedding-site" when omitted.
# project_tag = "wedding-site"
